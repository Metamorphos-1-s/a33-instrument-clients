<Window x:Class="A33.Instrument.Wpf.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="A33 Instrument Monitor" Width="1180" Height="760" MinWidth="980" MinHeight="640" Background="#F3F5F6">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolVisibility"/>
    <Style TargetType="TextBox"><Setter Property="Padding" Value="8,6"/><Setter Property="Margin" Value="0,4"/><Setter Property="BorderBrush" Value="#BAC4C9"/></Style>
    <Style TargetType="ComboBox"><Setter Property="Padding" Value="8,6"/><Setter Property="Margin" Value="0,4"/></Style>
    <Style TargetType="Button"><Setter Property="Padding" Value="14,7"/><Setter Property="Margin" Value="0,4,8,4"/></Style>
    <Style x:Key="Label" TargetType="TextBlock"><Setter Property="Foreground" Value="#68767E"/><Setter Property="FontSize" Value="12"/></Style>
    <Style x:Key="Value" TargetType="TextBlock"><Setter Property="Foreground" Value="#182026"/><Setter Property="FontSize" Value="15"/><Setter Property="Margin" Value="0,2,0,10"/></Style>
    <Style x:Key="Panel" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#DCE2E5"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="5"/><Setter Property="Padding" Value="18"/><Setter Property="Margin" Value="0,0,14,14"/></Style>
  </Window.Resources>
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Grid.Row="0" Background="#182026" Padding="22,15"><DockPanel><StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><TextBlock Text="{Binding State}" Foreground="#73D7B0" FontWeight="SemiBold" Margin="0,4,16,0"/><TextBlock Text="{Binding Endpoint}" Foreground="#C9D2D6" Margin="0,4,0,0"/></StackPanel><TextBlock Text="A33 Instrument" Foreground="White" FontSize="22" FontWeight="SemiBold"/></DockPanel></Border>
    <Grid Grid.Row="1" Margin="20"><Grid.ColumnDefinitions><ColumnDefinition Width="310"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto"><StackPanel>
        <Border Style="{StaticResource Panel}"><StackPanel><TextBlock Text="CONNECTION" FontWeight="SemiBold" Margin="0,0,0,10"/><TextBlock Text="Transport" Style="{StaticResource Label}"/><ComboBox ItemsSource="{Binding TransportModes}" SelectedIndex="{Binding TransportIndex,Mode=TwoWay}" IsEnabled="{Binding CanConfigure}"/>
          <StackPanel Visibility="{Binding IsTcp,Converter={StaticResource BoolVisibility}}"><TextBlock Text="Host" Style="{StaticResource Label}"/><TextBox Text="{Binding Host}" IsEnabled="{Binding CanConfigure}"/><TextBlock Text="TCP port" Style="{StaticResource Label}"/><TextBox Text="{Binding Port}" IsEnabled="{Binding CanConfigure}"/></StackPanel>
          <StackPanel Visibility="{Binding IsRtu,Converter={StaticResource BoolVisibility}}"><DockPanel><TextBlock Text="COM port" Style="{StaticResource Label}"/><Button Content="Refresh" Command="{Binding RefreshPortsCommand}" DockPanel.Dock="Right" Padding="8,3"/></DockPanel><ComboBox ItemsSource="{Binding SerialPorts}" SelectedItem="{Binding SerialPort}" IsEnabled="{Binding CanConfigure}"/><TextBlock Text="Baud (8 data bits)" Style="{StaticResource Label}"/><TextBox Text="{Binding BaudRate}" IsEnabled="{Binding CanConfigure}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Parity" Style="{StaticResource Label}"/><ComboBox SelectedIndex="{Binding ParityIndex}" IsEnabled="{Binding CanConfigure}"><ComboBoxItem Content="None"/><ComboBoxItem Content="Even"/><ComboBoxItem Content="Odd"/></ComboBox></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Stop bits" Style="{StaticResource Label}"/><ComboBox SelectedIndex="{Binding StopBitsIndex}" IsEnabled="{Binding CanConfigure}"><ComboBoxItem Content="1"/><ComboBoxItem Content="2"/></ComboBox></StackPanel></Grid><TextBlock Text="RS232 and RS485 share one RTU client; connect only one physical adapter." Foreground="#A15C00" TextWrapping="Wrap" FontSize="11"/></StackPanel>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Unit ID" Style="{StaticResource Label}"/><TextBox Text="{Binding UnitId}" IsEnabled="{Binding CanConfigure}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Request timeout ms" Style="{StaticResource Label}"/><TextBox Text="{Binding RequestTimeoutMs}" IsEnabled="{Binding CanConfigure}"/></StackPanel></Grid><TextBlock Text="Connect timeout ms" Style="{StaticResource Label}"/><TextBox Text="{Binding ConnectTimeoutMs}" IsEnabled="{Binding CanConfigure}"/><TextBlock Text="Fast poll ms" Style="{StaticResource Label}"/><TextBox Text="{Binding PollIntervalMs}" IsEnabled="{Binding CanConfigure}"/>
          <WrapPanel Margin="0,10,0,0"><Button Content="Connect" Command="{Binding ConnectCommand}" Background="#087F5B" Foreground="White"/><Button Content="Disconnect" Command="{Binding DisconnectCommand}"/></WrapPanel><WrapPanel><Button Content="Start monitoring" Command="{Binding StartCommand}"/><Button Content="Stop" Command="{Binding StopCommand}"/></WrapPanel>
        </StackPanel></Border>
        <Border Style="{StaticResource Panel}"><StackPanel><TextBlock Text="CONTRACT" FontWeight="SemiBold" Margin="0,0,0,10"/><TextBlock Text="Register map" Style="{StaticResource Label}"/><TextBlock Text="{Binding MapVersion}" Style="{StaticResource Value}"/><TextBlock Text="Runtime policy" Style="{StaticResource Label}"/><TextBlock Text="FC03 read-only monitor; runtime operations use the frozen mailbox contract" Style="{StaticResource Value}" TextWrapping="Wrap"/></StackPanel></Border>
        <Border Style="{StaticResource Panel}"><StackPanel><TextBlock Text="RUNTIME OPERATIONS" FontWeight="SemiBold" Margin="0,0,0,10"/><TextBlock Text="Only execute after confirmation and a fresh MONITORING snapshot." Style="{StaticResource Label}" TextWrapping="Wrap"/><WrapPanel Margin="0,8,0,0"><Button Content="ZERO" Command="{Binding ZeroCommand}"/><Button Content="TARE" Command="{Binding TareCommand}"/><Button Content="Clear TARE" Command="{Binding ClearTareCommand}"/></WrapPanel><WrapPanel><Button Content="NET" Command="{Binding NetViewCommand}"/><Button Content="GROSS" Command="{Binding GrossViewCommand}"/></WrapPanel><TextBlock Text="Command state" Style="{StaticResource Label}" Margin="0,8,0,0"/><TextBlock Text="{Binding CommandState}" Style="{StaticResource Value}"/><TextBlock Text="Transaction" Style="{StaticResource Label}"/><TextBlock Text="{Binding CommandTransaction}" Style="{StaticResource Value}"/><TextBlock Text="Last operation" Style="{StaticResource Label}"/><TextBlock Text="{Binding LastOperation}" Style="{StaticResource Value}"/><TextBlock Text="{Binding CommandResult}" Foreground="#A15C00" TextWrapping="Wrap"/><TextBlock Text="RESULT UNCERTAIN — refresh state before another operation" Foreground="#B42318" TextWrapping="Wrap" Visibility="{Binding HasUncertainResult,Converter={StaticResource BoolVisibility}}"/><Button Content="Refresh state (clear uncertainty)" Command="{Binding RefreshRuntimeStateCommand}"/></StackPanel></Border>
      </StackPanel></ScrollViewer>
      <StackPanel Grid.Column="1"><Border Style="{StaticResource Panel}"><StackPanel><TextBlock Text="CONFIGURATION TRANSACTION" FontWeight="SemiBold"/><TextBlock Text="{Binding ConfigurationState}" Style="{StaticResource Value}"/><TextBlock Text="Brightness (0-7, device contract)" Style="{StaticResource Label}"/><TextBox Text="{Binding BrightnessText,UpdateSourceTrigger=PropertyChanged}"/><Button Content="Stage brightness edit" Command="{Binding EditBrightnessCommand}"/><TextBlock Text="{Binding ConfigurationDifferences}" TextWrapping="Wrap"/><WrapPanel><Button Content="Refresh configuration" Command="{Binding RefreshConfigurationCommand}"/><Button Content="Validate" Command="{Binding ValidateConfigurationCommand}"/><Button Content="Apply RAM" Command="{Binding ApplyConfigurationCommand}"/><Button Content="Save to Flash" Command="{Binding SaveConfigurationCommand}"/><Button Content="Cancel" Command="{Binding CancelConfigurationCommand}"/></WrapPanel><TextBlock Text="Only the safe non-calibration whitelist is editable. Calibration, communication and reset fields are blocked." Style="{StaticResource Label}" TextWrapping="Wrap"/></StackPanel></Border>
      <TabControl Background="Transparent" BorderThickness="0">
        <TabItem Header="MONITOR"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="14,14,0,0"><Border Background="#182026" CornerRadius="5" Padding="24" Margin="0,0,0,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="CURRENT WEIGHT" Foreground="#BFC9CD"/><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Weight}" Foreground="White" FontSize="62" FontWeight="SemiBold"/><TextBlock Text="{Binding Unit}" Foreground="#73D7B0" FontSize="22" Margin="12,30,0,0"/></StackPanel></StackPanel><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Stability}" Foreground="#73D7B0" FontSize="18"/><TextBlock Text="{Binding Overload}" Foreground="#F5B7AF" Margin="0,8,0,0"/></StackPanel></Grid></Border>
          <UniformGrid Columns="3"><Border Style="{StaticResource Panel}"><StackPanel><TextBlock Text="NET" Style="{StaticResource Label}"/><TextBlock Text="{Binding Net}" Style="{StaticResource Value}"/></StackPanel></Border><Border Style="{StaticResource Panel}"><StackPanel><TextBlock Text="GROSS" Style="{StaticResource Label}"/><TextBlock Text="{Binding Gross}" Style="{StaticResource Value}"/></StackPanel></Border><Border Style="{StaticResource Panel}"><StackPanel><TextBlock Text="TARE" Style="{StaticResource Label}"/><TextBlock Text="{Binding Tare}" Style="{StaticResource Value}"/></StackPanel></Border></UniformGrid>
          <Border Style="{StaticResource Panel}"><UniformGrid Columns="4"><StackPanel><TextBlock Text="Zero" Style="{StaticResource Label}"/><TextBlock Text="{Binding Zero}" Style="{StaticResource Value}"/></StackPanel><StackPanel><TextBlock Text="Checkweigh" Style="{StaticResource Label}"/><TextBlock Text="{Binding Checkweigh}" Style="{StaticResource Value}"/></StackPanel><StackPanel><TextBlock Text="Last update" Style="{StaticResource Label}"/><TextBlock Text="{Binding LastUpdate}" Style="{StaticResource Value}"/></StackPanel><StackPanel><TextBlock Text="Data age" Style="{StaticResource Label}"/><TextBlock Text="{Binding DataAge}" Style="{StaticResource Value}"/></StackPanel></UniformGrid></Border><Border Background="#FFF4E5" BorderBrush="#E8B66C" BorderThickness="1" Padding="12" Visibility="{Binding IsStale,Converter={StaticResource BoolVisibility}}"><TextBlock Text="DATA STALE — last value is retained for diagnostics and is not live" Foreground="#8A4B08" FontWeight="SemiBold"/></Border>
        </StackPanel></ScrollViewer></TabItem>
        <TabItem Header="DIAGNOSTICS"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="14,14,0,0"><Border Style="{StaticResource Panel}"><UniformGrid Columns="3"><StackPanel><TextBlock Text="TX / RX" Style="{StaticResource Label}"/><TextBlock Text="{Binding TxRx}" Style="{StaticResource Value}"/><TextBlock Text="Timeouts" Style="{StaticResource Label}"/><TextBlock Text="{Binding Timeouts}" Style="{StaticResource Value}"/></StackPanel><StackPanel><TextBlock Text="CRC / MBAP" Style="{StaticResource Label}"/><TextBlock><Run Text="{Binding CrcErrors,Mode=OneWay}"/><Run Text=" / "/><Run Text="{Binding MbapErrors,Mode=OneWay}"/></TextBlock><TextBlock Text="Unit errors" Style="{StaticResource Label}" Margin="0,10,0,0"/><TextBlock Text="{Binding UnitErrors}" Style="{StaticResource Value}"/></StackPanel><StackPanel><TextBlock Text="Exceptions / Bad frames" Style="{StaticResource Label}"/><TextBlock><Run Text="{Binding Exceptions,Mode=OneWay}"/><Run Text=" / "/><Run Text="{Binding BadFrames,Mode=OneWay}"/></TextBlock><TextBlock Text="Reconnects" Style="{StaticResource Label}" Margin="0,10,0,0"/><TextBlock Text="{Binding Reconnects}" Style="{StaticResource Value}"/></StackPanel></UniformGrid></Border><Border Style="{StaticResource Panel}"><StackPanel><TextBlock Text="Last request (bounded)" Style="{StaticResource Label}"/><TextBox Text="{Binding LastRequest,Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"/><TextBlock Text="Last response (bounded)" Style="{StaticResource Label}" Margin="0,10,0,0"/><TextBox Text="{Binding LastResponse,Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"/><TextBlock Text="Last error" Style="{StaticResource Label}" Margin="0,10,0,0"/><TextBlock Text="{Binding LastError}" Foreground="#B42318" TextWrapping="Wrap"/></StackPanel></Border><WrapPanel><Button Content="Copy summary" Command="{Binding CopyDiagnosticsCommand}"/><Button Content="Clear local statistics" Command="{Binding ClearDiagnosticsCommand}"/></WrapPanel></StackPanel></ScrollViewer></TabItem>
      </TabControl></StackPanel>
    </Grid>
    <Border Grid.Row="2" Background="White" BorderBrush="#DCE2E5" BorderThickness="0,1,0,0" Padding="20,9"><TextBlock><Run Text="State: "/><Run Text="{Binding State,Mode=OneWay}" FontWeight="SemiBold"/><Run Text="  |  Endpoint: "/><Run Text="{Binding Endpoint,Mode=OneWay}"/><Run Text="  |  Unit ID: "/><Run Text="{Binding UnitId,Mode=OneWay}"/><Run Text="  |  Transport errors: "/><Run Text="{Binding TransportErrors,Mode=OneWay}"/><Run Text="  |  Last success: "/><Run Text="{Binding LastSuccess,Mode=OneWay}"/></TextBlock></Border>
  </Grid>
</Window>
